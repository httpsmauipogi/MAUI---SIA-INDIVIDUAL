# Copy this file to .env on the EC2 instance, then fill in the secrets.
APP_NAME="Healix HMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://13.236.57.159

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL runs in the db container on the same EC2 instance.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=healix
DB_USERNAME=healix
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_MYSQL_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Public uploads (images) go to S3. Credentials come from the EC2 instance role.
FILESYSTEM_DISK=s3
PUBLIC_DISK_DRIVER=s3
PUBLIC_DISK_URL=https://healix-hms-uploads-87284509958.s3.us-east-1.amazonaws.com
PRIVATE_DISK_DRIVER=s3
AWS_PRIVATE_PREFIX=private
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=healix-hms-uploads-87284509958
AWS_URL=https://healix-hms-uploads-87284509958.s3.us-east-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false
# Leave blank - the EC2 instance profile supplies credentials automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email: start with "log" (emails are written to storage/logs/laravel.log).
# To send real mail later, switch to "smtp" and use SES SMTP credentials.
MAIL_MAILER=log
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@healix.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
